# Copy to .env.runtime in the API package, set the develop DB URL privately, then chmod 600.
# The URL must resolve to the existing `db` service and database `mindforge_develop`.
MINDFORGE_ENVIRONMENT=develop
MINDFORGE_DATABASE_URL=postgres://mindforge_develop:replace-with-private-password@db:5432/mindforge_develop?sslmode=disable
MINDFORGE_AUTH_USER_URL=http://auth-develop:9999/user
MINDFORGE_AUTH_CALLBACK_URL=http://127.0.0.1:11001/v1/auth/callback
MINDFORGE_AUTH_REDIRECT_URLS=mindforge-dev://auth/callback,http://web-mind.home.arpa/login/callback
MINDFORGE_LISTEN_ADDR=:8080
