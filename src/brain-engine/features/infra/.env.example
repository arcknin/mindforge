# Copy this file to .env and replace every replace-with-* value.
# validate-config.sh rejects placeholders, empty values, weak secrets, wildcard redirects
# and non-loopback binds without ALLOW_LAN_BINDING=yes. Never commit a real .env file.

# PostgreSQL: POSTGRES_PORT is the host port; containers always use db:5432.
POSTGRES_DB=mindforge
POSTGRES_USER=mindforge
POSTGRES_PASSWORD=replace-with-a-uri-safe-password-of-at-least-16-characters
POSTGRES_HOST=db
POSTGRES_PORT=5432
DB_BIND_ADDR=127.0.0.1

# Auth: AUTH_PORT is the host port; GoTrue and its healthcheck always use 9999 internally.
AUTH_PORT=9999
AUTH_BIND_ADDR=127.0.0.1
ALLOW_LAN_BINDING=no

# Keep this exact URI synchronized with the PostgreSQL values above.
GOTRUE_DB_DATABASE_URL=postgres://mindforge:replace-with-a-uri-safe-password-of-at-least-16-characters@db:5432/mindforge?sslmode=disable&search_path=auth

# Auth boundaries: explicit URLs only; no wildcard redirect/origin entries.
GOTRUE_SITE_URL=http://127.0.0.1:3000
GOTRUE_ADDITIONAL_REDIRECT_URLS=http://127.0.0.1:3000
GOTRUE_URI_ALLOW_LIST=http://127.0.0.1:3000
GOTRUE_API_EXTERNAL_URL=http://127.0.0.1:9999

# Auth secrets: use distinct, URI-safe values of at least 32 characters.
GOTRUE_JWT_SECRET=replace-with-a-distinct-jwt-secret-of-at-least-32-characters
GOTRUE_OPERATOR_TOKEN=replace-with-a-distinct-operator-token-of-at-least-32-characters
GOTRUE_DB_MAX_POOL_SIZE=10
# Keep false for ordinary operator configuration. Disposable acceptance generates true.
GOTRUE_MAILER_AUTOCONFIRM=false
TZ=America/Sao_Paulo
