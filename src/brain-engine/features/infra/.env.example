# Copy this file to .env for the owner-designated VM and replace every replace-with-* value.
# validate-config.sh rejects placeholders, empty values, weak secrets, wildcard redirects
# and non-loopback binds without ALLOW_LAN_BINDING=yes. Never commit a real .env file.
# Local or disposable PostgreSQL/Docker runtime is not a substitute for the VM.

# PostgreSQL: one persistent cluster; POSTGRES_PORT is the host port and the
# containers always use db:5432. The cluster admin database is PostgreSQL's
# required `postgres` database. The two application names below are fixed.
# Host-side operator/psql connections use POSTGRES_CLIENT_HOST and POSTGRES_PORT;
# Auth containers continue to use the internal POSTGRES_HOST service alias.
POSTGRES_ADMIN_USER=replace-with-cluster-admin-user
POSTGRES_ADMIN_PASSWORD=replace-with-a-uri-safe-cluster-password-of-at-least-16-characters
POSTGRES_HOST=db
POSTGRES_CLIENT_HOST=127.0.0.1
POSTGRES_PORT=5432
DB_BIND_ADDR=127.0.0.1

DEVELOP_DB_NAME=mindforge_develop
DEVELOP_DB_USER=replace-with-develop-db-user
DEVELOP_DB_PASSWORD=replace-with-a-uri-safe-develop-password-of-at-least-16-characters
MAIN_DB_NAME=mindforge
MAIN_DB_USER=replace-with-main-db-user
MAIN_DB_PASSWORD=replace-with-a-uri-safe-main-password-of-at-least-16-characters

# Each Auth service is pinned to its own database URL and role. Keep the
# internal endpoint and `search_path=auth` exact; the validator rejects swaps.
DEVELOP_AUTH_DB_URL=postgres://replace-with-develop-db-user:replace-with-a-uri-safe-develop-password-of-at-least-16-characters@db:5432/mindforge_develop?sslmode=disable&search_path=auth
MAIN_AUTH_DB_URL=postgres://replace-with-main-db-user:replace-with-a-uri-safe-main-password-of-at-least-16-characters@db:5432/mindforge?sslmode=disable&search_path=auth

# Auth: each host port is distinct; GoTrue and its healthchecks always use 9999 internally.
DEVELOP_AUTH_PORT=10000
MAIN_AUTH_PORT=9999
DEVELOP_AUTH_BIND_ADDR=127.0.0.1
MAIN_AUTH_BIND_ADDR=127.0.0.1
ALLOW_LAN_BINDING=no

# Auth boundaries: explicit environment-specific URLs only; no wildcard
# redirect/origin entries. Do not reuse the two public Auth base URLs.
DEVELOP_AUTH_SITE_URL=http://127.0.0.1:3000
MAIN_AUTH_SITE_URL=http://127.0.0.1:3001
DEVELOP_AUTH_ADDITIONAL_REDIRECT_URLS=http://127.0.0.1:3000
MAIN_AUTH_ADDITIONAL_REDIRECT_URLS=http://127.0.0.1:3001
DEVELOP_AUTH_URI_ALLOW_LIST=http://127.0.0.1:3000
MAIN_AUTH_URI_ALLOW_LIST=http://127.0.0.1:3001
DEVELOP_AUTH_API_EXTERNAL_URL=http://127.0.0.1:10000
MAIN_AUTH_API_EXTERNAL_URL=http://127.0.0.1:9999

# Auth secrets: use distinct, URI-safe values of at least 32 characters in
# both environments and across JWT/operator roles.
DEVELOP_AUTH_JWT_SECRET=replace-with-a-distinct-develop-jwt-secret-of-at-least-32-characters
MAIN_AUTH_JWT_SECRET=replace-with-a-distinct-main-jwt-secret-of-at-least-32-characters
DEVELOP_AUTH_OPERATOR_TOKEN=replace-with-a-distinct-develop-operator-token-of-at-least-32-characters
MAIN_AUTH_OPERATOR_TOKEN=replace-with-a-distinct-main-operator-token-of-at-least-32-characters
GOTRUE_DB_MAX_POOL_SIZE=10
# Keep false for ordinary operator configuration.
GOTRUE_MAILER_AUTOCONFIRM=false
TZ=America/Sao_Paulo
