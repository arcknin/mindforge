# Copy to a private .env in this directory and replace every placeholder.
# This file is separate from the infrastructure .env and contains only the
# credentials required by these four Studio/Meta services.
#
# Reuse the existing owner role for each target. Do not paste the root infra
# .env here and do not commit the completed file.

STUDIO_MAIN_DB_NAME=mindforge
STUDIO_MAIN_DB_USER=replace-with-existing-main-owner-role
STUDIO_MAIN_DB_PASSWORD=replace-with-existing-main-owner-password
STUDIO_MAIN_META_CRYPTO_KEY=replace-with-unique-main-meta-key-32-characters
STUDIO_MAIN_AUTH_JWT_SECRET=replace-with-unique-main-studio-jwt-secret-32chars

STUDIO_DEVELOP_DB_NAME=mindforge_develop
STUDIO_DEVELOP_DB_USER=replace-with-existing-develop-owner-role
STUDIO_DEVELOP_DB_PASSWORD=replace-with-existing-develop-owner-password
STUDIO_DEVELOP_META_CRYPTO_KEY=replace-with-unique-develop-meta-key-32-characters
STUDIO_DEVELOP_AUTH_JWT_SECRET=replace-with-unique-develop-studio-jwt-secret-32chars
